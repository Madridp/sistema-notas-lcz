DROP TABLE IF EXISTS `Alumnos`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `Alumnos` (
  `id_estudiante` int NOT NULL AUTO_INCREMENT,
  `codigo_mineduc` varchar(50) DEFAULT NULL,
  `nombres` varchar(100) DEFAULT NULL,
  `apellidos` varchar(100) DEFAULT NULL,
  `id_grado` int DEFAULT NULL,
  `id_seccion` int DEFAULT NULL,
  `estado` tinyint(1) DEFAULT '1',
  `ESTADO_REGISTRO` int DEFAULT '1',
  PRIMARY KEY (`id_estudiante`),
  KEY `id_grado` (`id_grado`),
  KEY `id_seccion` (`id_seccion`),
  CONSTRAINT `Alumnos_ibfk_1` FOREIGN KEY (`id_grado`) REFERENCES `Grados` (`id_grado`),
  CONSTRAINT `Alumnos_ibfk_2` FOREIGN KEY (`id_seccion`) REFERENCES `Secciones` (`id_seccion`)
) ENGINE=InnoDB AUTO_INCREMENT=1949 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
