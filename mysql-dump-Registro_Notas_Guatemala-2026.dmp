CREATE TABLE `Notas_Oficiales` (
  `id_nota` int NOT NULL AUTO_INCREMENT,
  `id_estudiante` int DEFAULT NULL,
  `id_materia` int DEFAULT NULL,
  `unidad_1` varchar(20) DEFAULT '',
  `unidad_2` varchar(20) DEFAULT '',
  `unidad_3` varchar(20) DEFAULT '',
  `unidad_4` varchar(20) DEFAULT '',
  `ESTADO_REGISTRO` int DEFAULT '1',
  PRIMARY KEY (`id_nota`),
  KEY `id_estudiante` (`id_estudiante`),
  KEY `id_materia` (`id_materia`),
  CONSTRAINT `Notas_Oficiales_ibfk_1` FOREIGN KEY (`id_estudiante`) REFERENCES `Alumnos` (`id_estudiante`),
  CONSTRAINT `Notas_Oficiales_ibfk_2` FOREIGN KEY (`id_materia`) REFERENCES `Materias_Oficiales` (`id_materia`)
) ENGINE=InnoDB AUTO_INCREMENT=81333 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
